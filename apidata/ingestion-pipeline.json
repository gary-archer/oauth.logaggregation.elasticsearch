{
  "description": "Ingest Pipeline for API Logs",
  "processors": [
    {
      "drop": {
        "if" : "ctx.type != 'request' && ctx.type != 'audit'"
      }
    },
    {
      "date" : {
        "field" : "utcTime",
        "target_field": "@timestamp",
        "formats" : ["ISO8601"]
      }
    },
    {
      "remove": {
        "field": ["fields", "log", "stream"],
        "ignore_missing": true
      }
    },
    {
      "reroute": {
        "if": "ctx.type == 'audit'",
        "destination": "api-audit"
      }
    }
  ]
}

{
  "description": "Ingest Pipeline for API Logs",
  "processors": [
    {
      "drop": {
        "if" : "ctx.type != 'request' && ctx.type != 'audit'"
      }
    },
    {
      "date" : {
        "field" : "utcTime",
        "target_field": "@timestamp",
        "formats" : ["ISO8601"]
      }
    },
    {
      "remove": {
        "field": ["log", "stream", "type", "utcTime", "fields"],
        "ignore_missing": true
      }
    }
  ]
}
